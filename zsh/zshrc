title-protect() {
  emulate -L zsh

  local config_tools="${CONFIG_TOOLS:-$HOME/.local/bin/config-tools}"
  if [[ ! -x "$config_tools" ]]; then
    printf '\033[31mconfig-tools binary missing: %s\033[0m\n' "$config_tools" >&2
    printf 'Run: cargo run --manifest-path "$HOME/src/config/Cargo.toml" -- install\n' >&2
    return 127
  fi
  if (( $# == 0 )); then
    printf 'usage: title-protect <command> [args...]\n' >&2
    return 2
  fi

  local command_name="$1"
  shift
  local resolved_command="$command_name"
  if [[ "$command_name" != */* ]]; then
    resolved_command="$(whence -p -- "$command_name")" || {
      printf '\033[31mcommand not found: %s\033[0m\n' "$command_name" >&2
      return 127
    }
  fi

  (( $+functions[__terminal_title_set] )) && __terminal_title_set
  "$config_tools" title-protect -- "$resolved_command" "$@"
  local exit_status=$?
  (( $+functions[__terminal_title_set] )) && __terminal_title_set
  return $exit_status
}

axiom() {
  title-protect atlas relay --agent axiom "$@"
}

