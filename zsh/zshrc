########################################
# Claude Code (auto-update)
########################################

zmodload zsh/datetime

__claude_update_stale() {
  local stamp=~/.claude/.last-update-check
  local last=0
  if [[ -s "$stamp" ]]; then
    last=$(cat "$stamp" 2>/dev/null)
    [[ "$last" == <-> ]] || last=0
  fi
  (( EPOCHSECONDS - last > 3600 ))
}

__claude_update_run() {
  [[ -d ~/.claude ]] || return 0
  local remote
  remote=$(curl -sf --connect-timeout 3 --max-time 5 \
    https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/latest \
    | tr -d '[:space:]')
  [[ -n "$remote" ]] || return 0
  local local_v
  local_v=$(command claude --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  if [[ "$remote" = "$local_v" ]]; then
    # Already current — record successful check so we don't re-curl
    printf '%s' "$EPOCHSECONDS" >| ~/.claude/.last-update-check
    return 0
  fi
  # Version differs — attempt install (clear CLAUDECODE so the binary doesn't
  # refuse to run when invoked from a terminal spawned by Claude Code)
  if CLAUDECODE= curl -fsSL https://claude.ai/install.sh | CLAUDECODE= bash &>/dev/null; then
    printf '%s' "$EPOCHSECONDS" >| ~/.claude/.last-update-check
    # Prune old versions, keep only the two most recent
    local versions_dir=~/.local/share/claude/versions
    if [[ -d "$versions_dir" ]]; then
      local old
      for old in "$versions_dir"/*(Nom[3,-1]); do
        rm -f "$old"
      done
    fi
  fi
  # On failure: stamp is NOT written → next shell retries immediately
}

# Background check on shell startup (don't block terminal opening)
if __claude_update_stale; then
  { __claude_update_run } &!
fi

########################################
# Tool initialization (lazy loading)
########################################

# Pyenv (lazy init to avoid blocking startup)
if command -v pyenv >/dev/null 2>&1; then
  pyenv() {
    unset -f pyenv
    eval "$(command pyenv init - --no-rehash --no-push-path zsh)"
    pyenv "$@"
  }
fi

# SDKMAN (lazy init to avoid blocking startup)
typeset -g __SDKMAN_INIT_SCRIPT="$SDKMAN_DIR/bin/sdkman-init.sh"
if [[ -s "$__SDKMAN_INIT_SCRIPT" ]]; then
  typeset -gi __SDKMAN_LOADED=0

  __sdkman_lazy_load() {
    (( __SDKMAN_LOADED )) && return 0
    if ! source "$__SDKMAN_INIT_SCRIPT"; then
      printf '\033[31msdkman init failed: %s\033[0m\n' "$__SDKMAN_INIT_SCRIPT" >&2
      return 1
    fi
    __SDKMAN_LOADED=1
    return 0
  }

  sdk() {
    if (( ! __SDKMAN_LOADED )); then
      __sdkman_lazy_load || return $?
    fi
    sdk "$@"
  }

  autoload -Uz add-zsh-hook 2>/dev/null

  __sdkman_maybe_load_for_dir() {
    if (( __SDKMAN_LOADED )); then
      add-zsh-hook -d chpwd __sdkman_maybe_load_for_dir 2>/dev/null
      return 0
    fi
    if [[ -f .sdkmanrc ]]; then
      __sdkman_lazy_load || return $?
      add-zsh-hook -d chpwd __sdkman_maybe_load_for_dir 2>/dev/null
    fi
    return 0
  }

  add-zsh-hook chpwd __sdkman_maybe_load_for_dir
  __sdkman_maybe_load_for_dir
fi

########################################
# Remove "command not found" from history
########################################
typeset -gi __hist_last_exit=0
__hist_capture_exit() { __hist_last_exit=$? }
__hist_remove_notfound() {
    if (( __hist_last_exit == 127 )); then
        [[ -f "$HISTFILE" ]] && LC_ALL=C sed -i '' '$d' "$HISTFILE" 2>/dev/null
    fi
    __hist_last_exit=0
}
precmd_functions+=(__hist_capture_exit __hist_remove_notfound)

########################################
# External configuration
########################################
if [[ -r "$HOME/.local/bin/env" ]]; then
  . "$HOME/.local/bin/env"
fi

