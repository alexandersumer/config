# Font
font-family = JetBrains Mono
font-size = 14

# Theme (follows macOS dark mode)
theme = light:catppuccin-latte,dark:catppuccin-mocha

# Window
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# macOS
# Treat the left Option key as Alt/Meta for shell shortcuts while keeping
# right Option available for macOS text input and special characters.
macos-option-as-alt = left
