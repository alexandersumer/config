# Font
font-family = JetBrains Mono
font-size = 14

# Theme
theme = catppuccin-mocha

# Window
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
window-new-tab-position = end

# macOS
# Use transparent macOS chrome for the most seamless dark fullscreen tab look.
# Keep native fullscreen and disable save-state restoration to avoid extra
# tab/window transition paths.
macos-titlebar-style = transparent
macos-non-native-fullscreen = false
window-save-state = never

# Treat the left Option key as Alt/Meta for shell shortcuts while keeping
# right Option available for macOS text input and special characters.
macos-option-as-alt = left

# Shell
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false
