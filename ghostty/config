# Font
font-family = JetBrains Mono
font-size = 14

# Theme
theme = catppuccin-mocha

# Window
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
window-new-tab-position = end

# macOS
# Keep fullscreen tabs on the native macOS path. The transparent/titlebar-tabs
# paths reproduce dark fullscreen tab chrome glitches on macOS 26; native tabs
# avoid that custom path while dark chrome matches this Mac's appearance.
macos-titlebar-style = native
macos-non-native-fullscreen = false
window-theme = dark
window-save-state = never

# Treat the left Option key as Alt/Meta for shell shortcuts while keeping
# right Option available for macOS text input and special characters.
macos-option-as-alt = left

# Shell
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false
