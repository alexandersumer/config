{
  "model": "opus",
  "alwaysThinkingEnabled": true,
  "includeCoAuthoredBy": false,
  "additionalDirectories": ["~/src", "~/.claude", "~/.rovodev"],

  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Task",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "ask": [],
    "deny": []
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo \"$ARGUMENTS\" | jq -r '.file_path'); if [ -f \"$FILE\" ]; then prettier --write \"$FILE\" 2>/dev/null; eslint --fix \"$FILE\" 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
