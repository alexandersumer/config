{
  "model": "opus",
  "alwaysThinkingEnabled": true,
  "includeCoAuthoredBy": false,
  "additionalDirectories": ["~/src", "~/.claude", "~/.rovodev"],

  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Task",
      "WebFetch",
      "WebSearch",
      "Write"
    ],

    "ask": [
      "Bash(git push*)",

      "Bash(git merge *)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",

      "Bash(git reset --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git reset --keep*)",
      "Bash(git clean*)",
      "Bash(git restore*)",

      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",

      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git stash pop*)",

      "Bash(git remote remove*)",
      "Bash(git remote rm*)",
      "Bash(git worktree remove*)",
      "Bash(git submodule deinit*)",

      "Bash(git reflog expire*)",
      "Bash(git gc*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",

      "Bash(rm *)",
      "Bash(rmdir*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chmod*)",
      "Bash(chown*)",
      "Bash(chgrp*)",
      "Bash(kill *)",
      "Bash(killall*)",
      "Bash(pkill*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(poweroff*)",
      "Bash(systemctl*)",
      "Bash(service *)",
      "Bash(launchctl*)",

      "Bash(docker run*)",
      "Bash(docker exec*)",
      "Bash(docker start*)",
      "Bash(docker stop*)",
      "Bash(docker restart*)",
      "Bash(docker kill*)",
      "Bash(docker rm*)",
      "Bash(docker rmi*)",
      "Bash(docker build*)",
      "Bash(docker push*)",
      "Bash(docker pull*)",
      "Bash(docker tag*)",
      "Bash(docker save*)",
      "Bash(docker load*)",
      "Bash(docker import*)",
      "Bash(docker export*)",
      "Bash(docker commit*)",
      "Bash(docker create*)",
      "Bash(docker cp*)",
      "Bash(docker attach*)",
      "Bash(docker network create*)",
      "Bash(docker network rm*)",
      "Bash(docker network connect*)",
      "Bash(docker network disconnect*)",
      "Bash(docker volume create*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(docker image prune*)",
      "Bash(docker container prune*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose start*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose rm*)",
      "Bash(docker compose pull*)",
      "Bash(docker compose build*)",
      "Bash(docker compose exec*)",
      "Bash(docker compose run*)",
      "Bash(docker-compose up*)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose start*)",
      "Bash(docker-compose stop*)",
      "Bash(docker-compose restart*)",
      "Bash(docker-compose rm*)",
      "Bash(docker-compose pull*)",
      "Bash(docker-compose build*)",
      "Bash(docker-compose exec*)",
      "Bash(docker-compose run*)",

      "Bash(kubectl apply*)",
      "Bash(kubectl create*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl replace*)",
      "Bash(kubectl set*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl exec*)",
      "Bash(kubectl run*)",
      "Bash(kubectl expose*)",
      "Bash(kubectl label*)",
      "Bash(kubectl annotate*)",
      "Bash(kubectl taint*)",
      "Bash(kubectl cordon*)",
      "Bash(kubectl uncordon*)",
      "Bash(kubectl drain*)",
      "Bash(kubectl cp*)",
      "Bash(kubectl attach*)",
      "Bash(kubectl port-forward*)",
      "Bash(kubectl proxy*)",

      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform taint*)",
      "Bash(terraform untaint*)",
      "Bash(terraform state mv*)",
      "Bash(terraform state rm*)",
      "Bash(terraform state push*)",
      "Bash(terraform state replace-provider*)",
      "Bash(terraform workspace new*)",
      "Bash(terraform workspace delete*)",
      "Bash(terraform workspace select*)",
      "Bash(terraform force-unlock*)",
      "Bash(terraform refresh*)",

      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr review --approve*)",

      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",

      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",

      "Bash(gh release delete*)",
      "Bash(gh run cancel*)",
      "Bash(gh secret remove*)",
      "Bash(gh variable remove*)",
      "Bash(gh label delete*)",

      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)"
    ],

    "deny": []
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo \"$ARGUMENTS\" | jq -r '.file_path'); if [ -f \"$FILE\" ]; then prettier --write \"$FILE\" 2>/dev/null; eslint --fix \"$FILE\" 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
